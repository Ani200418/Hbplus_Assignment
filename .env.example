# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.

# Approved organization email domain (exact match, no "@")
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=hbplus.fit

# Require Google to report the email as verified ("true" is the default and recommended)
EXPO_PUBLIC_REQUIRE_VERIFIED_EMAIL=true

# Firebase console -> Project settings -> General -> Your apps -> Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Cloud console -> APIs & Services -> Credentials
# Web client ID is used on web and as the audience for native ID tokens
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID reversed form is derived from this value by app.config.ts
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
